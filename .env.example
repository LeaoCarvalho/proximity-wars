# Copy this file to .env and fill it in. .env is not committed (see .gitignore).
# On Render, set the same two variables under Environment instead.

# Turso database URL (Turso dashboard > your database > URL), e.g. libsql://proximity-wars-yourname.turso.io
TURSO_DATABASE_URL=

# Turso auth token (Turso dashboard > your database > Create Token, read & write)
TURSO_AUTH_TOKEN=
